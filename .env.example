# ─────────────────────────────────────────────────────────────────────────────
# Research Orchestrator — environment template.
#
# Copy to `.env` and fill in REAL values for your environment. `.env` is
# gitignored and must never be committed. This file contains ONLY placeholders.
#
# The live Octocode bridge (bridges/octocode-mcp.ts) reads these at first call.
# Pick ONE transport (stdio | sse | http) and configure its block below.
# ─────────────────────────────────────────────────────────────────────────────

# Point the orchestrator at the compiled bridge module.
RESEARCH_OCTOCODE_BRIDGE=./dist/bridges/octocode-mcp.js

# Transport: "stdio" (spawn a subprocess) | "sse" | "http"
RESEARCH_OCTOCODE_TRANSPORT=stdio

# ── stdio transport ──────────────────────────────────────────────────────────
# Executable to spawn as the Octocode MCP server (and its arguments).
RESEARCH_OCTOCODE_COMMAND=npx
# A JSON array of args, OR a space-split string. Example: run the published pkg.
RESEARCH_OCTOCODE_ARGS=["-y","@octocodeai/mcp@latest"]
# Optional working directory for the subprocess (defaults to inherited).
# RESEARCH_OCTOCODE_CWD=

# ── sse / http transport ─────────────────────────────────────────────────────
# Only used when RESEARCH_OCTOCODE_TRANSPORT is "sse" or "http".
# RESEARCH_OCTOCODE_URL=http://localhost:3001/sse
# Bearer token sent as the Authorization header. PLACEHOLDER ONLY.
# RESEARCH_OCTOCODE_API_KEY=replace-with-your-real-api-key

# ── behaviour (all optional, defaults shown) ─────────────────────────────────
# Max retry attempts for transient failures (>= 0).
# RESEARCH_OCTOCODE_MAX_RETRIES=3
# Base backoff in ms for jittered exponential retry.
# RESEARCH_OCTOCODE_BASE_BACKOFF_MS=500
# Per-call timeout in ms.
# RESEARCH_OCTOCODE_TIMEOUT_MS=60000
# MCP client name advertised during the handshake.
# RESEARCH_OCTOCODE_CLIENT_NAME=research-orchestrator
# Set to 1 / true to emit bridge diagnostics to stderr.
# RESEARCH_OCTOCODE_DEBUG=0

# ── other providers (stubs; not required for Octocode mode) ──────────────────
# GitHub REST provider (optional, only used with --mode github).
# GITHUB_TOKEN=replace-with-your-real-github-token
