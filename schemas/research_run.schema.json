{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/research-orchestrator/research_run.schema.json",
  "title": "ResearchRun",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "goal",
    "featureSpec",
    "probes",
    "candidates",
    "scoredCandidates",
    "selectedRepos",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "parentRunId": { "type": "string", "minLength": 1 },
    "providerName": { "enum": ["octocode", "github", "deepwiki", "local", "mock"] },
    "schemaVersion": { "const": 2 },
    "evidencePolicyVersion": {
      "type": "string",
      "enum": ["phase1_exact_quotation_v1", "phase2_claim_evidence_v2", "legacy_unvalidated"]
    },
    "evidenceOrigin": {
      "type": "string",
      "enum": ["repository_observation", "synthetic_mock", "legacy_unvalidated"]
    },
    "createdAt": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "featureSpec": {
      "$ref": "feature_spec.schema.json"
    },
    "probes": {
      "type": "array",
      "items": {
        "$ref": "search_probe.schema.json"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "candidate_repo.schema.json"
      }
    },
    "scoredCandidates": {
      "type": "array",
      "items": {
        "$ref": "scored_candidate.schema.json"
      }
    },
    "selectedRepos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observations": { "type": "array", "items": { "$ref": "source_observation.schema.json" } },
    "assessments": { "type": "array", "items": { "$ref": "claim_assessment.schema.json" } },
    "coverage": { "type": "array", "items": { "$ref": "question_coverage.schema.json" } },
    "outcome": { "$ref": "run_outcome.schema.json" },
    "candidateStates": { "type": "array", "items": { "$ref": "candidate_state.schema.json" } },
    "explanationResults": { "type": "array", "items": { "$ref": "repo_explanation_result.schema.json" } },
    "brief": { "$ref": "research_brief.schema.json" },
    "probesV2": { "type": "array", "items": { "$ref": "search_probe_v2.schema.json" } },
    "compiledProbes": { "type": "array", "items": { "$ref": "search_probe_v2.schema.json" } },
    "probeOutcomes": { "type": "array", "items": { "$ref": "probe_outcome.schema.json" } },
    "budgetLedger": { "$ref": "budget_ledger.schema.json" },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "source", "answers", "implementationMap", "warnings"],
        "properties": {
          "repo": { "type": "string" },
          "evidencePolicyVersion": {
            "type": "string",
            "enum": ["phase1_exact_quotation_v1", "phase2_claim_evidence_v2", "legacy_unvalidated"]
          },
          "evidenceOrigin": {
            "type": "string",
            "enum": ["repository_observation", "synthetic_mock", "legacy_unvalidated"]
          },
          "source": {
            "type": "string",
            "enum": ["deepwiki", "octocode_fallback", "hybrid", "mock"]
          },
          "freshness": {
            "type": "object",
            "required": ["checkedAt"],
            "properties": {
              "checkedAt": { "type": "string" },
              "lastIndexedAt": { "type": "string" },
              "indexedCommit": { "type": "string" },
              "stale": { "type": "boolean" }
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "answer", "evidence", "confidence", "verified"],
              "properties": {
                "question": { "type": "string" },
                "answer": { "type": "string" },
                "evidence": {
                  "type": "array",
                  "items": { "$ref": "evidence_anchor.schema.json" }
                },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "verified": { "type": "boolean" }
              }
            }
          },
          "implementationMap": {
            "type": "object",
            "required": ["dependencies", "files", "serverFlow", "clientFlow", "environmentVariables", "pitfalls"],
            "properties": {
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "role", "evidence"],
                  "properties": {
                    "path": { "type": "string" },
                    "role": { "type": "string" },
                    "keyExports": { "type": "array", "items": { "type": "string" } },
                    "evidence": {
                      "type": "array",
                      "items": { "$ref": "evidence_anchor.schema.json" }
                    }
                  }
                }
              },
              "serverFlow": { "type": "array", "items": { "type": "string" } },
              "clientFlow": { "type": "array", "items": { "type": "string" } },
              "environmentVariables": { "type": "array", "items": { "type": "string" } },
              "routeProtection": { "type": "array", "items": { "type": "string" } },
              "tests": { "type": "array", "items": { "type": "string" } },
              "pitfalls": { "type": "array", "items": { "type": "string" } }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
          }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "createdAt"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": ["research", "plan", "evidence", "checklist", "report"]
          },
          "createdAt": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "required": ["id", "evidencePolicyVersion", "providerName", "createdAt", "goal", "featureSpec", "probes", "candidates", "scoredCandidates", "selectedRepos", "artifacts", "warnings", "schemaVersion", "observations", "assessments", "coverage", "outcome", "candidateStates", "explanationResults"],
        "properties": { "evidencePolicyVersion": { "const": "phase2_claim_evidence_v2" } }
      }
    },
    {
      "if": { "required": ["brief"] },
      "then": { "required": ["probeOutcomes", "budgetLedger"] }
    }
  ]
}
